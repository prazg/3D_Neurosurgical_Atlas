   [
    "vert_lumb_sup",
    "vert_lumb_lat"
   ]
  ],
  [
   "corpus callosum|fornix",
   [
    "midsag_cc",
    "midsagittal"
   ]
  ],
  [
   "substantia nigra|red nucleus",
   [
    "midbrain",
    "coronal_bg_plane"
   ]
  ],
  [
   "olfactory|optic chiasm|optic tract|optic nerve|mammill",
   [
    "brain_inferior"
   ]
  ],
  [
   "pericallosal|^anterior cerebral artery|(occipital|temporal) pars of posterior cerebral",
   [
    "medial_arteries"
   ]
  ],
  [
   "lenticulostriate",
   [
    "ich"
   ]
  ],
  [
   "^oligo",
   [
    "oligodendrocyte",
    "microglia"
   ]
  ],
  [
   "^astro|^gbm|^enhancing tumour|^necrotic|peritumoural",
   [
    "astrocyte",
    "microglia"
   ]
  ],
  [
   "^skull$",
   [
    "skull_vertex",
    "skull"
   ]
  ],
  [
   "mastoidectomy",
   [
    "temporal_bone"
   ]
  ],
  [
   "brain surface|brain shell|telencephalon",
   [
    "lobes",
    "brain_superior"
   ]
  ],
  [
   "\\(mra atlas\\)|^anterior cerebral artery|pars of (middle|posterior) cerebral|^basilar (left|right)|lenticulostriate|choroidal and thalamoperf|^(superior|inferior) cerebellar (left|right)",
   [
    "circle_willis",
    "brain_base_arteries"
   ]
  ],
  [
   "pars of middle cerebral|lateral lenticulostriate",
   [
    "infarct"
   ]
  ],
  [
   "common carotid|internal carotid$|external carotid|vertebral artery|brachiocephalic|arch of aorta",
   [
    "neck_arteries",
    "circle_willis"
   ]
  ],
  [
   "sinus \\(schematic\\)",
   [
    "meninges"
   ]
  ],
  [
   "^skull$|craniotomy",
   [
    "skull",
    "meninges"
   ]
  ],
  [
   "ventricle|aqueduct|choroid plexus",
   [
    "csf",
    "axial_bg"
   ]
  ],
  [
   "hypophysis|infundibulum|pituitary",
   [
    "pituitary"
   ]
  ],
  [
   "\\(cn [ivx]+|^pons$|medulla|midbrain|colliculus|^brainstem",
   [
    "brainstem"
   ]
  ],
  [
   "cochlea|vestibular schwannoma",
   [
    "labyrinth",
    "inner_ear"
   ]
  ],
  [
   "caudate|putamen|pallidus|claustrum|accumbens|thalamic nucleus|^thal |pulvinar|subthalamic|diencephalon",
   [
    "coronal_bg_plane",
    "axial_bg"
   ]
  ],
  [
   "cerebell|^(left|right)-|vermis|dentate",
   [
    "cerebellum"
   ]
  ],
  [
   "gyrus|lobule|cuneus|precuneus|frontal pole|temporal pole|insula$|visual cortex|telencephalon|limen insulae",
   [
    "brain_regions"
   ]
  ],
  [
   "spinal cord",
   [
    "cord_c5",
    "cord_t8"
   ]
  ],
  [
   "^cervical\\d|^atlas|^axis|c1 vertebra|c2 vertebra|^_vertebra",
   [
    "vertebra_sup",
    "cord_c5"
   ]
  ],
  [
   "spine metastasis case",
   [
    "vertebra_lat",
    "lumbar_canal"
   ]
  ],
  [
   "^thoracic\\d",
   [
    "vert_thor_sup",
    "cord_t8"
   ]
  ],
  [
   "gyrus|lobule|cuneus|precuneus|frontal pole|temporal pole|insula$|visual cortex|limen insulae",
   [
    "lobes"
   ]
  ],
  [
   "hypophysis|infundibulum|pituitary|hypothal",
   [
    "pituitary_portal"
   ]
  ],
  [
   "^midbrain$|part of midbrain",
   [
    "midbrain"
   ]
  ],
  [
   "superior sagittal sinus",
   [
    "skull_vertex"
   ]
  ],
  [
   "cochlea|vestibular schwannoma|vestibulocochlear|facial nerve",
   [
    "temporal_bone"
   ]
  ],
  [
   "^keypoint: (bregma|lambda)|^coronal suture|^sagittal suture|^lambdoid suture",
   [
    "skull_vertex",
    "skull"
   ]
  ],
  [
   "^keypoint: (nasion|glabella)|^(frontal|parietal|occipital) bone|frontonasal suture",
   [
    "skull",
    "skull_vertex"
   ]
  ],
  [
   "^(left |right )?temporal bone|^keypoint: (asterion|mastoid)|occipitomastoid|squamous suture",
   [
    "temporal_bone",
    "skull"
   ]
  ],
  [
   "^keypoint: (opisthion|basion)",
   [
    "brainstem",
    "skull"
   ]
  ],
  [
   "^(ethmoid bone|vomer|(left|right) nasal bone|(left|right) maxilla|(left|right) palatine|(left|right) lacrimal)",
   [
    "nasal_cavity",
    "paranasal"
   ]
  ],
  [
   "^sphenoid bone",
   [
    "nasal_cavity",
    "pituitary"
   ]
  ],
  [
   "^surface projection: .*(rolandic|sylvian)",
   [
    "lobes",
    "brain_regions"
   ]
  ],
  [
   "^keypoint: (pterion|keyhole|frontozygomatic)|sphenoparietal|sphenofrontal|sphenosquamosal",
   [
    "skull",
    "lobes"
   ]
  ]
 ],
